---
import Layout from "./Layout.astro";
import "../styles/global.css";
import { createClient } from "../lib/supabase";

const supabase = createClient({
  request: Astro.request,
  cookies: Astro.cookies,
});

const { data } = await supabase.auth.getUser();
const user = data?.user;

if (!user) {
  return Astro.redirect("/");
}

const { data: profile } = await supabase
  .from("profiles")
  .select("*")
  .eq("id", user.id)
  .single();
---

<Layout>
  <div
    class="flex w-full min-h-screen bg-canvas-white has-[:checked]:md:hidden"
  >
    <input type="checkbox" id="menu-toggle" class="hidden peer" />

    <div
      class="md:hidden fixed top-0 left-0 right-0 h-16 bg-midnight-ink border-b border-ash-gray flex items-center px-4 z-20"
    >
      <label for="menu-toggle" class="cursor-pointer">
        <svg class="w-6 h-6" fill="none" stroke="white" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </label>
      <span class="text-white font-bold text-lg font-display ml-4">Freelio</span
      >
    </div>

    <aside
      class="fixed md:relative bg-midnight-ink left-0 top-0 bottom-0 md:top-auto md:bottom-auto md:w-72 bg-surface-dark flex flex-col items-center justify-between py-6 px-4 z-10 hidden md:flex md:items-start md:px-6 -translate-x-full md:translate-x-0 transition-transform peer-checked:translate-x-0 w-64"
    >
      <div class="w-full flex flex-col gap-8">
        <h1 class="text-white font-bold text-2xl font-display">Freelio</h1>

        <nav class="flex flex-col gap-4 w-full">
          <a
            href="/dashboard"
            class="flex items-center gap-4 px-4 py-3 rounded-full bg-white/15 text-white font-medium text-sm transition-colors hover:bg-white/25"
          >
            <svg width="20" height="20" fill="none" viewBox="0 0 24 24">
              <rect x="3" y="3" width="7" height="7" rx="1" fill="white"></rect>
              <rect
                x="14"
                y="3"
                width="7"
                height="7"
                rx="1"
                fill="white"
                fill-opacity="0.4"></rect>
              <rect
                x="3"
                y="14"
                width="7"
                height="7"
                rx="1"
                fill="white"
                fill-opacity="0.4"></rect>
              <rect
                x="14"
                y="14"
                width="7"
                height="7"
                rx="1"
                fill="white"
                fill-opacity="0.4"></rect>
            </svg>
            <span>Dashboard</span>
          </a>

          <a
            href="/calendar"
            class="flex items-center gap-4 px-4 py-3 rounded-full text-white/60 font-medium text-sm transition-colors hover:bg-white/10 hover:text-white"
          >
            <svg width="20" height="20" fill="none" viewBox="0 0 24 24">
              <rect
                x="3"
                y="5"
                width="18"
                height="16"
                rx="2"
                stroke="white"
                stroke-width="1.5"
                stroke-opacity="0.6"></rect>
              <path
                d="M8 3v4M16 3v4M3 10h18"
                stroke="white"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-opacity="0.6"></path>
            </svg>
            <span>Calendario</span>
          </a>

          <a
            href="/clients"
            class="flex items-center gap-4 px-4 py-3 rounded-full text-white/60 font-medium text-sm transition-colors hover:bg-white/10 hover:text-white"
          >
            <svg width="20" height="20" fill="none" viewBox="0 0 24 24">
              <circle
                cx="9"
                cy="7"
                r="4"
                stroke="white"
                stroke-width="1.5"
                stroke-opacity="0.6"></circle>
              <path
                d="M3 21v-1a6 6 0 0 1 12 0v1"
                stroke="white"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-opacity="0.6"></path>
            </svg>
            <span>Clientes</span>
          </a>
        </nav>
      </div>

      <div class="w-full flex items-center gap-3 px-3 py-3">
        <img
          src={profile?.avatar_url}
          alt="Profile Picture"
          class="w-10 h-10 rounded-full shrink-0"
        />
        <div class="min-w-0">
          <p class="text-white font-bold text-sm">{profile?.full_name}</p>
          <a href="/api/auth/signout">
            <button>
              <p class="text-steel-gray text-xs">Cerrar sesión</p>
            </button>
          </a>
        </div>
      </div>
    </aside>

    <main class="w-full md:flex-1 pt-16 md:pt-0 px-6 py-8">
      <slot />
    </main>
  </div>
</Layout>
