---

---

<div class="min-h-screen bg-canvas-white flex flex-col">
  <header class="flex items-center justify-between px-6 py-6 md:px-8">
    <div class="text-midnight-ink font-bold text-2xl font-display">Freelio</div>
    <a href="/api/auth/signin" class="px-6 py-2 text-midnight-ink font-medium text-sm hover:opacity-80 transition-opacity">
      Entrar
    </a>
  </header>


  <main class="flex-1 flex items-center justify-center px-6 md:px-8 py-8 md:py-16 overflow-hidden">
    <div class="max-w-7xl w-full grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-16 items-center relative">
      

      <div class="relative z-10 flex flex-col gap-6">
        <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold font-display text-midnight-ink leading-tight">
          Conocé<br />Freelio
        </h1>

        <p class="text-base md:text-lg text-steel-gray max-w-md">
          Gestioná clientes, agenda y brand kits con IA. Cobrá, entregá y mantené todo en orden — en una sola plataforma.
        </p>

        <p class="text-sm md:text-base text-midnight-ink font-medium">
          Freelance. Hecho mejor.
        </p>


        <div class="pt-4">
          <a 
            href="/api/auth/signin" 
            class="inline-flex items-center gap-3 px-6 py-3 bg-midnight-ink text-white font-medium text-sm rounded-full hover:bg-opacity-90 transition-all shadow-md hover:shadow-lg"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z"/>
            </svg>
            Empezar →
          </a>
        </div>
      </div>


      <div class="relative hidden md:block h-96 lg:h-full">

        <div class="absolute top-0 right-0 w-48 h-32 bg-vivid-green rounded-lg"></div>

        <div class="absolute top-12 -right-8 w-40 h-24 bg-bubblegum-pink rounded-lg"></div>

     
        <div class="absolute top-32 right-20 w-20 h-20 bg-vivid-green rounded-full"></div>

 
        <div class="absolute top-48 right-0 w-32 h-20 bg-cadet-blue rounded-lg"></div>

   
        <div class="absolute top-56 right-40 w-24 h-12 bg-composer-blue rounded-lg"></div>


        <div class="absolute bottom-32 right-12 w-32 h-16 bg-sunny-yellow rounded-lg"></div>

  
        <div class="absolute bottom-8 right-32 w-48 h-24 bg-bubblegum-pink rounded-lg"></div>

  
        <div class="absolute bottom-16 left-0 w-20 h-12 bg-vivid-green rounded-lg"></div>

    
        <div class="absolute bottom-0 left-32 w-24 h-12 bg-cadet-blue rounded-lg"></div>
      </div>
    </div>
  </main>


  <footer class="px-6 py-6 md:px-8 border-t border-ash-gray text-steel-gray text-sm">
    © 2026 Freelio
  </footer>
</div>
