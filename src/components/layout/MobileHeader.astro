---
const { profile } = Astro.props;

if (!profile) {
  return null;
}

---

<input type="checkbox" id="menu-toggle" class="hidden peer" />

<div class="md:hidden fixed top-0 left-0 right-0 h-16 bg-midnight-ink border-b  flex items-center px-4 z-30">
  <label for="menu-toggle" class="cursor-pointer select-none p-1">
    <svg class="w-6 h-6" fill="none" stroke="white" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
    </svg>
  </label>
  <span class="text-white font-bold text-lg font-display ml-4">Freelio</span>
</div>

<div class="md:hidden flex flex-col justify-between  fixed top-16 left-0 bottom-0 w-64 bg-midnight-ink border-r  z-20 transform -translate-x-full peer-checked:translate-x-0 transition-transform duration-300 ease-in-out">
  <nav class="flex flex-col p-4 gap-2">
    <a href="/dashboard" data-astro-prefetch="hover" class="text-white font-body text-(--text-body) py-2 px-3 rounded-sm hover:bg-white/10 transition-colors">
      Dashboard
    </a>
    <a href="/calendar" data-astro-prefetch="hover" class="text-white font-body text-(--text-body) py-2 px-3 rounded-sm hover:bg-white/10 transition-colors">
      Calendario
    </a>
    <a href="/clients" data-astro-prefetch="hover" class="text-white font-body text-(--text-body) py-2 px-3 rounded-sm hover:bg-white/10 transition-colors">
      Clientes
    </a>
  </nav>

    <div class="w-full   flex items-center gap-3 px-3 py-3">
    <img
      src={profile?.avatar_url}
      alt="Profile Picture"
      class="w-10 h-10 rounded-full shrink-0"
    />
    <div class="min-w-0">
      <p class="text-white font-bold text-sm">{profile?.full_name}</p>
      <a href="/api/auth/signout" data-astro-reload>
        <button>
          <p class="text-steel-gray text-xs">Cerrar sesión</p>
        </button>
      </a>
    </div>
  </div>
</div>

<label 
  for="menu-toggle" 
  class="md:hidden fixed inset-0 bg-black/40 backdrop-blur-[1px] z-10 pointer-events-none opacity-0 peer-checked:pointer-events-auto peer-checked:opacity-100 transition-opacity duration-300"
/>
