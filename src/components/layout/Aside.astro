---
import { LayoutDashboard, CalendarDays, Users } from "@lucide/astro";

const { profile } = Astro.props;

if (!profile) {
  return null;
}

const currentPath = Astro.url.pathname;

const navItems = [
  { href: "/dashboard", label: "Dashboard", Icon: LayoutDashboard },
  { href: "/calendar", label: "Calendario", Icon: CalendarDays },
  { href: "/clients", label: "Clientes", Icon: Users },
];
---

<aside
  class="fixed md:relative inset-y-0 left-0 w-64 md:w-[240px] bg-midnight-ink flex flex-col justify-between py-8 px-4 z-30 -translate-x-full peer-checked:translate-x-0 md:translate-x-0 transition-transform duration-300"
>
  <div class="w-full flex flex-col gap-10">
    <h1 class="text-white font-bold text-heading font-display tracking-tight px-3">Freelio</h1>

    <nav class="flex flex-col gap-2 w-full">
      {
        navItems.map(({ href, label, Icon }) => {
          const isActive = currentPath.startsWith(href);
          return (
            <a
              href={href}
              data-astro-prefetch="hover"
              class:list={[
                "flex items-center gap-3 px-4 py-3 rounded-full font-body font-medium text-body-sm transition-all",
                isActive
                  ? "bg-white text-midnight-ink"
                  : "text-steel-gray hover:bg-white/10 hover:text-white",
              ]}
            >
              <Icon color={isActive ? "#000000" : "#bec6cc"} size={18} />
              <span>{label}</span>
            </a>
          );
        })
      }
    </nav>
  </div>

  <div class="w-full flex items-center gap-3 px-3 py-4">
    <div class="relative w-10 h-10 shrink-0">
      <div id="avatar-skeleton" class="skeleton absolute inset-0 w-full h-full rounded-full" />
      <img
        src={profile?.avatar_url}
        alt="Profile Picture"
        class="relative w-10 h-10 rounded-full object-cover"
        onload="document.getElementById('avatar-skeleton').style.display='none'"
      />
    </div>
    <div class="min-w-0 flex flex-col gap-0.5">
      <p class="text-white font-body font-semibold text-body-sm truncate">{profile?.full_name}</p>
      <a href="/api/auth/signout" data-astro-reload class="inline-block">
        <button class="bg-transparent border-none p-0 cursor-pointer outline-none">
          <p class="text-steel-gray font-body text-caption hover:text-white transition-colors">Cerrar sesión</p>
        </button>
      </a>
    </div>
  </div>
</aside>
