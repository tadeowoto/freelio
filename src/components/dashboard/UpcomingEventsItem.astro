---
const { evento } = Astro.props;

function formatFechaEvento(iso: string) {
  const d = new Date(iso);
  return {
    fecha: d.toLocaleDateString("es-AR", { day: "numeric", month: "short" }),
    hora: d.toLocaleTimeString("es-AR", { hour: "2-digit", minute: "2-digit" }),
  };
}

const colorPorTipo: Record<string, string> = {
  reunion: "bg-cadet-blue",
  deadline: "bg-hot-pink",
  entrega: "bg-vivid-green",
  pago: "bg-sunny-yellow",
  seguimiento: "bg-composer-blue",
  otro: "bg-steel-gray",
};

const { fecha, hora } = formatFechaEvento(evento.start_at);
const colorBarra = colorPorTipo[evento.type] ?? "bg-steel-gray";

const nombreCliente = Array.isArray(evento.clients)
  ? (evento.clients[0]?.name ?? null)
  : ((evento.clients as { name: string } | null)?.name ?? null);
---

<div
  class="flex items-center justify-between py-4 border-b border-ash-gray last:border-0 group hover:bg-canvas-white/50 transition-colors cursor-pointer"
>
  <div class="flex items-center gap-4">
    <div class={`w-1.5 h-10 rounded-full ${colorBarra} shrink-0`}></div>
    <div class="flex flex-col justify-center">
      <p class="font-display font-bold text-body text-midnight-ink leading-none mb-1.5 group-hover:text-composer-blue transition-colors">
        {evento.title}
      </p>
      <p class="font-body text-body-sm text-iron leading-none capitalize">
        {nombreCliente ? `${nombreCliente} · ` : ""}
        {evento.type}
      </p>
    </div>
  </div>
  <div class="flex flex-col items-end justify-center shrink-0 ml-4">
    <p class="font-body font-medium text-body-sm text-midnight-ink leading-none mb-1.5">{fecha}</p>
    <p class="font-body text-body-sm text-iron leading-none">{hora}</p>
  </div>
</div>