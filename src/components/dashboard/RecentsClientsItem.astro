---
const { client, index } = Astro.props;

const avatarColors = [
  "bg-cadet-blue",
  "bg-bubblegum-pink",
  "bg-vivid-green",
  "bg-sunny-yellow",
  "bg-hot-pink",
];

function clientInitials(name: string) {
  return name
    .split(" ")
    .slice(0, 2)
    .map((p) => p[0]?.toUpperCase() ?? "")
    .join("");
}

const initials = clientInitials(client.name);
const avatarColor = avatarColors[index % avatarColors.length];
const isActive = client.status === "activo";
---

<a
  href={`/clients/${client.id}`}
  class="flex items-center justify-between py-4 border-b border-ash-gray last:border-0 no-underline group hover:bg-canvas-white/50 transition-colors"
>
  <div class="flex items-center gap-4">
    <div
      class={`w-12 h-12 rounded-full ${avatarColor} flex items-center justify-center shrink-0`}
    >
      <span class="text-white font-display font-bold text-body">
        {initials}
      </span>
    </div>
    <div class="flex flex-col justify-center">
      <p
        class="font-display font-bold text-subheading text-midnight-ink leading-none mb-1 group-hover:text-composer-blue transition-colors"
      >
        {client.name}
      </p>
      <p class="font-body text-body-sm text-iron leading-none">
        {client.company ?? "Sin empresa"}
      </p>
    </div>
  </div>
  <span
    class={`font-body text-body-sm px-4 py-1.5 rounded-full font-medium shrink-0 ml-4 border ${
      isActive
        ? "bg-vivid-green border-vivid-green text-white"
        : "bg-canvas-white border-ash-gray text-steel-gray"
    }`}
  >
    {isActive ? "Activo" : "Inactivo"}
  </span>
</a>