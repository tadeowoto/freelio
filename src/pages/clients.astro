---
import MainLayout from "../layouts/MainLayout.astro";
import { clientsMock } from "../mocks/clients";
import ClientsCard from "../components/clients/ClientsCard.tsx";
import ClientsList from "../components/clients/ClientsList.tsx";
import { createClient } from "../lib/supabase.ts";
import NewClientButton from "../components/clients/NewClientButton.tsx";

const supabase = createClient({
  request: Astro.request,
  cookies: Astro.cookies,
});

const {
  data: { user },
} = await supabase.auth.getUser();

if (!user) {
  return Astro.redirect("/");
}

const { data: clients } = await supabase
  .from("clients")
  .select("*, brand_kits(colors)")
  .eq("user_id", user.id)
  .order("name", { ascending: true });

if (!clients) return Astro.redirect("/");
---

<MainLayout>
  <div class="w-full flex flex-col gap-10 mt-10">
    <div class="w-full flex flex-row items-center justify-between">
      <h1 class="font-display font-bold text-[56px] md:text-[80px] tracking-tighter text-midnight-ink leading-none">
        Clientes
      </h1>
      <NewClientButton client:load />
    </div>

    <ClientsList client:load clients={clients} />
  </div>
</MainLayout>