---
import MainLayout from "../layouts/MainLayout.astro";
import type { ClientWithBrandKit } from "../types/types";
import ClientsPage from "../components/clients/ClientsPage";
import { createClient } from "../lib/supabase.ts";

const supabase = createClient({
  request: Astro.request,
  cookies: Astro.cookies,
});

const {
  data: { user },
} = await supabase.auth.getUser();

if (!user) {
  return Astro.redirect("/");
}

const { data: rawClients } = await supabase
  .from("clients")
  .select("*, brand_kits(colors)")
  .eq("user_id", user.id)
  .order("name", { ascending: true });

if (!rawClients) return Astro.redirect("/");

const clients: ClientWithBrandKit[] = rawClients.map((c) => ({
  ...c,
  brand_kits: c.brand_kits as unknown as ClientWithBrandKit["brand_kits"],
}));
---

<MainLayout>
  <ClientsPage client:load clients={clients} />
</MainLayout>