---
import MainLayout from "../../layouts/MainLayout.astro";
import { createClient } from "../../lib/supabase.ts";
import ClientTabs from "../../components/clients/ClientTab.tsx";
import type { BrandKit as BrandKitType } from "../../types/types";

const supabase = createClient({
  request: Astro.request,
  cookies: Astro.cookies,
});

const {
  data: { user },
} = await supabase.auth.getUser();

if (!user) {
  return Astro.redirect("/");
}

const { id } = Astro.params;

if (!id) {
  return Astro.redirect("/clients");
}

const { data: client } = await supabase
  .from("clients")
  .select("*")
  .eq("id", id)
  .eq("user_id", user.id)
  .single();

if (!client) {
  return Astro.redirect("/clients");
}

const { data: rawBrandKit } = await supabase
  .from("brand_kits")
  .select("*")
  .eq("client_id", id)
  .single();

const brandKit = rawBrandKit ? (rawBrandKit as unknown as BrandKitType) : null;

const { data: events } = await supabase
  .from("events")
  .select("*")
  .eq("client_id", id);
---

<MainLayout>
  <div class="w-full flex flex-col gap-8 relative">
    
    <div class="absolute top-12 right-[10%] w-32 h-16 bg-hot-pink mix-blend-multiply opacity-90 pointer-events-none z-0">
      <div class="w-full h-full opacity-20" style="background-image: radial-gradient(circle at 1px 1px, black 1px, transparent 0); background-size: 8px 8px;"></div>
    </div>
    
    <div class="absolute -top-6 left-1/3 w-16 h-16 bg-vivid-green mix-blend-multiply pointer-events-none z-0"></div>

    <div class="z-10 mt-2">
      <a
        href="/clients"
        class="inline-flex items-center gap-2 font-body font-medium text-steel-gray hover:text-midnight-ink text-body-sm transition-colors group"
      >
        <span class="text-lg leading-none -mt-0.5 group-hover:-translate-x-0.5 transition-transform">&larr;</span> Clientes
      </a>
    </div>

    <div class="w-full flex flex-col gap-2 z-10 pb-6 border-b border-ash-gray">
      <p class="font-body text-body-sm text-iron leading-none">
        {client.company || "Sin empresa"} 
      </p>
      
      <div class="w-full flex flex-row items-end justify-between">
        <h1 class="font-display font-bold text-heading-lg md:text-[80px] tracking-tighter text-midnight-ink leading-none title-fade-in">
          {client.name}
        </h1>

        <div class="mb-2">
          {
            client.status === "activo" ? (
              <span class="px-5 py-2 font-body font-medium rounded-full bg-vivid-green text-white text-body-sm">
                Activo
              </span>
            ) : (
              <span class="px-5 py-2 font-body font-medium rounded-full bg-canvas-white border border-ash-gray text-steel-gray text-body-sm">
                Inactivo
              </span>
            )
          }
        </div>
      </div>
    </div>

    <div class="w-full z-10">
      <ClientTabs
        client={client}
        brandKit={brandKit}
        events={events ?? []}
        client:load
      />
    </div>
  </div>
</MainLayout>