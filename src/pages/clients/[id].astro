---
import MainLayout from "../../layouts/MainLayout.astro";
import { createClient } from "../../lib/supabase.ts";

const supabase = createClient({
  request: Astro.request,
  cookies: Astro.cookies,
});

const {
  data: { user },
} = await supabase.auth.getUser();

if (!user) {
  return Astro.redirect("/");
}

const { id } = Astro.params;

if (!id) {
  return Astro.redirect("/clients");
}

const { data: client } = await supabase
  .from("clients")
  .select("*")
  .eq("id", id)
  .eq("user_id", user.id)
  .single();

if (!client) {
  return Astro.redirect("/clients");
}

//TODO TRAER EL BRANDKIT PARA TRAER LOS COLORES Y LA INFO
---

<MainLayout>
  <div
    class="w-full max-w-(--page-max-width) mx-auto flex flex-col gap-(--section-gap) relative overflow-hidden"
  >
    <div
      class="absolute top-0 left-[-16px] w-4 h-12 bg-hot-pink pointer-events-none z-0"
    >
    </div>
    <div
      class="absolute top-0 right-32 w-12 h-6 bg-hot-pink opacity-80 pointer-events-none z-0 grid grid-cols-4 gap-1 p-1"
    >
      {
        Array.from({ length: 8 }).map(() => (
          <div class="bg-white/30 w-1 h-1 rounded-full" />
        ))
      }
    </div>

    <div class="z-10">
      <a
        href="/clients"
        class="inline-flex items-center gap-2 font-body text-steel-gray hover:text-graphite text-(--text-body-sm) transition-colors"
      >
        <span>&larr;</span> Clientes
      </a>
    </div>

    <div
      class="w-full flex flex-row items-end justify-between border-b border-ash-gray pb-2 z-10"
    >
      <div class="flex flex-col gap-1">
        <h1
          class="font-sans font-bold text-(--text-heading-lg) tracking-heading-lg text-midnight-ink leading-none"
        >
          {client.name}
        </h1>
      </div>

      <div>
        {
          client.status === "activo" ? (
            <span class="px-4 py-1 font-body font-semibold rounded-full bg-vivid-green text-white text-(--text-body-sm)">
              Activo
            </span>
          ) : (
            <span class="px-4 py-1 font-body font-semibold rounded-full bg-ash-gray text-steel-gray text-(--text-body-sm)">
              Inactivo
            </span>
          )
        }
      </div>
    </div>

    <div class="flex flex-row gap-6 border-b border-ash-gray/50 z-10 -mt-4">
      <button
        class="pb-3 font-body font-semibold text-(--text-body-sm) text-midnight-ink border-b-2 border-midnight-ink cursor-pointer"
      >
        Info
      </button>
      <button
        class="pb-3 font-body font-medium text-(--text-body-sm) text-steel-gray hover:text-graphite cursor-pointer transition-colors"
      >
        Brand Kit
      </button>
      <button
        class="pb-3 font-body font-medium text-(--text-body-sm) text-steel-gray hover:text-graphite cursor-pointer transition-colors"
      >
        Eventos
      </button>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start z-10">
      <div
        class="bg-white border border-ash-gray rounded-xl p-8 shadow-(--shadow-card) lg:col-span-2"
      >
        <h2
          class="font-sans font-bold text-(--text-subheading) tracking-subheading text-midnight-ink mb-6"
        >
          Información
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-y-6 gap-x-8">
          <div>
            <span
              class="block font-body text-[11px] font-bold text-steel-gray uppercase tracking-wider"
              >Empresa</span
            >
            <span
              class="block font-sans font-medium text-graphite text-(--text-body) mt-1"
              >{client.company || "—"}</span
            >
          </div>

          <div>
            <span
              class="block font-body text-[11px] font-bold text-steel-gray uppercase tracking-wider"
              >Email</span
            >
            <span
              class="block font-sans font-medium text-graphite text-(--text-body) mt-1"
              >{client.email || "—"}</span
            >
          </div>

          <div>
            <span
              class="block font-body text-[11px] font-bold text-steel-gray uppercase tracking-wider"
              >Teléfono</span
            >
            <span
              class="block font-sans font-medium text-graphite text-(--text-body) mt-1"
              >{client.phone || "—"}</span
            >
          </div>
        </div>
      </div>

      <div
        class="bg-white border border-ash-gray rounded-xl p-8 shadow-(--shadow-card) relative overflow-hidden"
      >
        <div
          class="absolute top-4 right-0 w-3 h-16 bg-hot-pink/90 rounded-l-sm"
        >
        </div>

        <h2
          class="font-sans font-bold text-(--text-subheading) tracking-subheading text-midnight-ink mb-4"
        >
          Notas
        </h2>
      </div>
    </div>
  </div>
</MainLayout>
