---
import MainLayout from "../../layouts/MainLayout.astro";
import { createClient } from "../../lib/supabase.ts";
import ClientTabs from "../../components/clients/ClientTab.tsx";

const supabase = createClient({
  request: Astro.request,
  cookies: Astro.cookies,
});

const {
  data: { user },
} = await supabase.auth.getUser();

if (!user) {
  return Astro.redirect("/");
}

const { id } = Astro.params;

if (!id) {
  return Astro.redirect("/clients");
}

const { data: client } = await supabase
  .from("clients")
  .select("*")
  .eq("id", id)
  .eq("user_id", user.id)
  .single();

if (!client) {
  return Astro.redirect("/clients");
}

const { data: brandKit } = await supabase
  .from("brand_kits")
  .select("*")
  .eq("client_id", id)
  .single();
---

<MainLayout>
  <div
    class="w-full max-w-(--page-max-width) mx-auto flex flex-col gap-(--section-gap) relative overflow-hidden"
  >
    <div
      class="absolute top-0 left-[-16px] w-4 h-12 bg-hot-pink pointer-events-none z-0"
    >
    </div>
    <div
      class="absolute top-0 right-32 w-12 h-6 bg-hot-pink opacity-80 pointer-events-none z-0 grid grid-cols-4 gap-1 p-1"
    >
      {
        Array.from({ length: 8 }).map(() => (
          <div class="bg-white/30 w-1 h-1 rounded-full" />
        ))
      }
    </div>

    <div class="z-10">
      <a
        href="/clients"
        class="inline-flex items-center gap-2 font-body text-steel-gray hover:text-graphite text-(--text-body-sm) transition-colors"
      >
        <span>&larr;</span> Clientes
      </a>
    </div>

    <div
      class="w-full flex flex-row items-end justify-between border-b border-ash-gray pb-2 z-10"
    >
      <div class="flex flex-col gap-1">
        <h1
          class="font-sans font-bold text-(--text-heading-lg) tracking-heading-lg text-midnight-ink leading-none"
        >
          {client.name}
        </h1>
      </div>

      <div>
        {
          client.status === "activo" ? (
            <span class="px-4 py-1 font-body font-semibold rounded-full bg-vivid-green text-white text-(--text-body-sm)">
              Activo
            </span>
          ) : (
            <span class="px-4 py-1 font-body font-semibold rounded-full bg-ash-gray text-steel-gray text-(--text-body-sm)">
              Inactivo
            </span>
          )
        }
      </div>
    </div>

    <ClientTabs client={client} brandKit={brandKit} client:load />
  </div>
</MainLayout>
