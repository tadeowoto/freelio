---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout>
  <section
    class="w-full max-w-[var(--page-max-width)] mx-auto p-[var(--spacing-8)] flex flex-col gap-[var(--section-gap)]"
  >
    <div class="w-full flex flex-row items-center justify-between">
      <h1
        class="font-sans font-bold text-[var(--text-heading-lg)] tracking-[var(--tracking-heading-lg)] text-[var(--color-midnight-ink)]"
      >
        Mayo De 2026
      </h1>

      <div class="flex flex-row items-center gap-[var(--spacing-4)]">
        <div class="flex flex-row items-center gap-[var(--spacing-2)]">
          <button
            class="w-10 h-10 flex items-center justify-center bg-white border border-[var(--color-ash-gray)] rounded-[var(--radius-full)] text-[var(--color-midnight-ink)] cursor-pointer hover:bg-[var(--color-canvas-white)] transition-colors"
          >
            <span class="text-[var(--text-body-sm)] font-medium">&lt;</span>
          </button>
          <button
            class="px-[var(--spacing-4)] h-10 flex items-center justify-center bg-white border border-[var(--color-ash-gray)] rounded-[var(--radius-full)] text-[var(--color-midnight-ink)] font-body font-medium text-[var(--text-body-sm)] cursor-pointer hover:bg-[var(--color-canvas-white)] transition-colors"
          >
            Hoy
          </button>
          <button
            class="w-10 h-10 flex items-center justify-center bg-white border border-[var(--color-ash-gray)] rounded-[var(--radius-full)] text-[var(--color-midnight-ink)] cursor-pointer hover:bg-[var(--color-canvas-white)] transition-colors"
          >
            <span class="text-[var(--text-body-sm)] font-medium">&gt;</span>
          </button>
        </div>

        <button
          class="h-10 px-[var(--spacing-6)] flex items-center gap-[var(--spacing-2)] bg-[var(--color-sunset-orange)] text-white border-none rounded-[var(--radius-sm)] font-sans font-medium text-[var(--text-body)] cursor-pointer hover:opacity-90 transition-opacity"
        >
          <span class="text-xl font-bold">+</span> Nuevo evento
        </button>
      </div>
    </div>

    <div
      class="flex flex-row items-center gap-[var(--spacing-4)] font-body text-[var(--text-body-sm)] text-[var(--color-graphite)] font-medium"
    >
      <div class="flex items-center gap-[var(--spacing-2)]">
        <span
          class="w-3 h-3 rounded-[var(--radius-full)] bg-[var(--color-composer-blue)]"
        ></span>
        <span>Reunión</span>
      </div>
      <div class="flex items-center gap-[var(--spacing-2)]">
        <span
          class="w-3 h-3 rounded-[var(--radius-full)] bg-[var(--color-sunset-orange)]"
        ></span>
        <span>Deadline</span>
      </div>
      <div class="flex items-center gap-[var(--spacing-2)]">
        <span
          class="w-3 h-3 rounded-[var(--radius-full)] bg-[var(--color-vivid-green)]"
        ></span>
        <span>Entrega</span>
      </div>
      <div class="flex items-center gap-[var(--spacing-2)]">
        <span
          class="w-3 h-3 rounded-[var(--radius-full)] bg-[var(--color-sunny-yellow)]"
        ></span>
        <span>Pago</span>
      </div>
      <div class="flex items-center gap-[var(--spacing-2)]">
        <span
          class="w-3 h-3 rounded-[var(--radius-full)] bg-[var(--color-bubblegum-pink)]"
        ></span>
        <span>Seguimiento</span>
      </div>
    </div>

    {<!-- ACA AGREGAR EL CALENDARIO -->}
</section>
</MainLayout>
