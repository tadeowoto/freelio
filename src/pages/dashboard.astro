---
import MainLayout from "../layouts/MainLayout.astro";
import { createClient } from "../lib/supabase.ts";
import UpcomingEventsItem from "../components/UpcomingEventsItem.astro";
import RecentsClientsItem from "../components/RecentsClientsItem.astro";
import InformationItem from "../components/InformationItem.astro";

const supabase = createClient({
  request: Astro.request,
  cookies: Astro.cookies,
});

const {
  data: { user },
} = await supabase.auth.getUser();

if (!user) {
  return Astro.redirect("/");
}

const { data: profile } = await supabase
  .from("profiles")
  .select("*")
  .eq("id", user.id)
  .single();

const firtstName = profile?.full_name.split(" ")[0] || "Freelancer";

const now = new Date();

const formattedDate = now.toLocaleDateString("es-AR", {
  weekday: "long",
  day: "numeric",
  month: "long",
  year: "numeric",
});

const hour = now.getHours();

const greeting =
  hour < 12 ? "Buenos días" : hour < 19 ? "Buenas tardes" : "Buenas noches";

const { count: clientesActivos } = await supabase
  .from("clients")
  .select("id", { count: "exact", head: true })
  .eq("user_id", user.id)
  .eq("status", "activo");

const startOfWeek = new Date(now);
startOfWeek.setDate(now.getDate() - now.getDay() + 1);
startOfWeek.setHours(0, 0, 0, 0);
const endOfWeek = new Date(startOfWeek);
endOfWeek.setDate(startOfWeek.getDate() + 6);
endOfWeek.setHours(23, 59, 59, 999);

const { count: eventosSemana } = await supabase
  .from("events")
  .select("id", { count: "exact", head: true })
  .eq("user_id", user.id)
  .gte("start_at", startOfWeek.toISOString())
  .lte("start_at", endOfWeek.toISOString())
  .neq("status", "cancelado");

const { count: cobrosPendientes } = await supabase
  .from("clients")
  .select("id", { count: "exact", head: true })
  .eq("user_id", user.id)
  .eq("payment_status", "pendiente");

const endWindow = new Date(now);
endWindow.setHours(now.getHours() + 72);

const { data: proximosEventos } = await supabase
  .from("events")
  .select("id, title, type, start_at, clients ( name )")
  .eq("user_id", user.id)
  .gte("start_at", now.toISOString())
  .lte("start_at", endWindow.toISOString())
  .neq("status", "cancelado")
  .order("start_at", { ascending: true })
  .limit(5);

const { data: clientesRecientes } = await supabase
  .from("clients")
  .select("id, name, company, status")
  .eq("user_id", user.id)
  .order("created_at", { ascending: false })
  .limit(5);
---

<MainLayout>
  <div class="relative mb-6">
    <p class="text-steel-gray text-sm mb-1">{formattedDate}</p>
    <h1
      class="text-6xl font-bold font-display text-midnight-ink leading-none max-w-64"
    >
      {greeting},{firtstName}.
    </h1>

    <div class="absolute top-0 right-0 w-32 h-24 pointer-events-none">
      <div class="absolute top-0 right-8 w-13 h-13 bg-vivid-green rounded-sm">
      </div>
      <div class="absolute top-4 right-0 w-15 h-9 bg-bubblegum-pink rounded-sm">
      </div>
      <div
        class="absolute top-10 right-6 w-10 h-10 bg-emerald-green rounded-full"
      >
      </div>
    </div>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-4 mb-6">
    <div
      class="bg-surface-card rounded-xl p-4 shadow-card flex items-start justify-between"
    >
      <InformationItem title="Clientes activos" number={clientesActivos} />
      <div class="w-12 h-12 rounded-full bg-vivid-green shrink-0"></div>
    </div>

    <div
      class="bg-surface-card rounded-xl p-4 shadow-card flex items-start justify-between"
    >
      <InformationItem title="Eventos de la semana" number={eventosSemana} />
      <div class="w-12 h-12 rounded-full bg-cadet-blue shrink-0"></div>
    </div>

    <div
      class="bg-surface-card rounded-xl p-4 shadow-card flex items-start justify-between"
    >
      <InformationItem title="Cobros pendientes" number={cobrosPendientes} />
      <div class="w-12 h-12 rounded-full bg-sunny-yellow shrink-0"></div>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
    <div class="bg-surface-card rounded-xl p-4 shadow-card">
      <div class="flex items-center justify-between mb-4">
        <h2 class="font-bold text-2xl font-display text-midnight-ink">
          Próximos eventos
        </h2>
        <a href="/calendar" class="text-sm text-steel-gray no-underline"
          >Ver todo ↗</a
        >
      </div>

      {
        proximosEventos && proximosEventos.length > 0 ? (
          proximosEventos.map((evento) => {
            return <UpcomingEventsItem evento={evento} />;
          })
        ) : (
          <div class="py-8 text-center">
            <p class="text-steel-gray text-sm">
              Sin eventos en las próximas 72 hs.
            </p>
            <a
              href="/calendar"
              class="text-sm text-cadet-blue no-underline mt-1 inline-block"
            >
              No hay eventos
            </a>
          </div>
        )
      }
    </div>

    <div class="bg-surface-card rounded-xl p-4 shadow-card">
      <div class="flex items-center justify-between mb-4">
        <h2 class="font-bold text-2xl font-display text-midnight-ink">
          Clientes recientes
        </h2>
        <a href="/clients" class="text-sm text-steel-gray no-underline"
          >Ver todo ↗</a
        >
      </div>

      {
        clientesRecientes && clientesRecientes.length > 0 ? (
          clientesRecientes.map((cliente, i) => {
            return <RecentsClientsItem client={cliente} index={i} />;
          })
        ) : (
          <p class="text-steel-gray text-sm">No hay clientes recientes</p>
        )
      }
    </div>
  </div>
</MainLayout>
