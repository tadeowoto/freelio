---
import MainLayout from "../layouts/MainLayout.astro";
import { createClient } from "../lib/supabase.ts";
import UpcomingEventsItem from "../components/dashboard/UpcomingEventsItem.astro";
import RecentsClientsItem from "../components/dashboard/RecentsClientsItem.astro";
import InformationItem from "../components/dashboard/InformationItem.tsx";

const supabase = createClient({
  request: Astro.request,
  cookies: Astro.cookies,
});

const {
  data: { user },
} = await supabase.auth.getUser();

if (!user) {
  return Astro.redirect("/");
}

const { data: profile } = await supabase
  .from("profiles")
  .select("*")
  .eq("id", user.id)
  .single();

const firstName = profile?.full_name.split(" ")[0] || "Freelancer";

const now = new Date();

const formattedDate = now.toLocaleDateString("es-AR", {
  weekday: "long",
  day: "numeric",
  month: "long",
  year: "numeric",
});

const hour = now.getHours();

const greeting =
  hour < 12 ? "Buenos días" : hour < 19 ? "Buenas tardes" : "Buenas noches";

const { count: clientesActivos } = await supabase
  .from("clients")
  .select("id", { count: "exact", head: true })
  .eq("user_id", user.id)
  .eq("status", "activo");

const startOfWeek = new Date(now);
startOfWeek.setDate(now.getDate() - now.getDay() + 1);
startOfWeek.setHours(0, 0, 0, 0);
const endOfWeek = new Date(startOfWeek);
endOfWeek.setDate(startOfWeek.getDate() + 6);
endOfWeek.setHours(23, 59, 59, 999);

const { count: eventosSemana } = await supabase
  .from("events")
  .select("id", { count: "exact", head: true })
  .eq("user_id", user.id)
  .gte("start_at", startOfWeek.toISOString())
  .lte("start_at", endOfWeek.toISOString())
  .neq("status", "cancelado");

const { count: cobrosPendientes } = await supabase
  .from("clients")
  .select("id", { count: "exact", head: true })
  .eq("user_id", user.id)
  .eq("payment_status", "pendiente");

const endWindow = new Date(now);
endWindow.setHours(now.getHours() + 72);

const { data: proximosEventos } = await supabase
  .from("events")
  .select("id, title, type, start_at, clients ( name )")
  .eq("user_id", user.id)
  .gte("start_at", now.toISOString())
  .lte("start_at", endWindow.toISOString())
  .neq("status", "cancelado")
  .order("start_at", { ascending: true })
  .limit(5);

const { data: clientesRecientes } = await supabase
  .from("clients")
  .select("id, name, company, status")
  .eq("user_id", user.id)
  .order("created_at", { ascending: false })
  .limit(5);
---

<MainLayout>
  <div class="relative pt-12 pb-16">
    <p class="font-body text-body-sm font-medium text-steel-gray mb-6 relative z-10 title-fade-in">
      {formattedDate}
    </p>
    
    <h1 class="font-display font-extrabold text-[64px] md:text-[88px] lg:text-[90px] text-midnight-ink leading-[0.9] tracking-tighter relative z-10 mix-blend-multiply title-fade-in-delayed">
      {greeting},<br/>{firstName}.
    </h1>

    <div class="absolute inset-0 pointer-events-none z-0 overflow-visible">
      <div class="absolute top-12 right-[15%] w-20 h-20 bg-vivid-green mix-blend-multiply"></div>
      <div class="absolute top-[40%] right-[2%] w-48 h-24 bg-bubblegum-pink mix-blend-multiply"></div>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <div class="bg-white border border-ash-gray rounded-md p-6 relative overflow-hidden flex items-start justify-between min-h-[140px]">
      <InformationItem client:load title="Clientes activos" number={clientesActivos} />
      <div class="absolute -top-4 -right-4 w-20 h-20 bg-vivid-green rounded-full"></div>
    </div>

    <div class="bg-white border border-ash-gray rounded-md p-6 relative overflow-hidden flex items-start justify-between min-h-[140px]">
      <InformationItem client:load title="Eventos de la semana" number={eventosSemana} />
      <div class="absolute -top-4 -right-4 w-20 h-20 bg-cadet-blue rounded-full"></div>
    </div>

    <div class="bg-white border border-ash-gray rounded-md p-6 relative overflow-hidden flex items-start justify-between min-h-[140px]">
      <InformationItem client:load title="Cobros pendientes" number={cobrosPendientes} />
      <div class="absolute -top-4 -right-4 w-20 h-20 bg-sunny-yellow rounded-full"></div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-[60%_auto] gap-6 mb-16">
    <div class="bg-white border border-ash-gray rounded-md p-6 flex flex-col">
      <div class="flex items-center justify-between mb-6 pb-4 border-b border-ash-gray">
        <h2 class="font-display font-bold text-subheading text-midnight-ink tracking-tight">
          Próximos eventos
        </h2>
        <a href="/calendar" class="font-body font-medium text-body-sm text-composer-blue hover:text-midnight-ink transition-colors group">
          Ver todo <span class="hover-arrow">↗</span>
        </a>
      </div>

      <div class="flex flex-col gap-2">
        {
          proximosEventos && proximosEventos.length > 0 ? (
            proximosEventos.map((evento) => {
              return <UpcomingEventsItem evento={evento} />;
            })
          ) : (
            <div class="py-12 flex flex-col items-center justify-center text-center bg-canvas-white border border-ash-gray rounded-md">
              <p class="font-body text-body-sm font-medium text-steel-gray">
                Sin eventos en las próximas 72 hs.
              </p>
              <a
                href="/calendar"
                class="font-body font-medium text-body-sm text-composer-blue hover:text-midnight-ink transition-colors mt-2"
              >
                No hay eventos
              </a>
            </div>
          )
        }
      </div>
    </div>

    <div class="bg-white border border-ash-gray rounded-md p-6 flex flex-col">
      <div class="flex items-center justify-between mb-6 pb-4 border-b border-ash-gray">
        <h2 class="font-display font-bold text-subheading text-midnight-ink tracking-tight">
          Clientes recientes
        </h2>
        <a href="/clients" class="font-body font-medium text-body-sm text-composer-blue hover:text-midnight-ink transition-colors group">
          Ver todo <span class="hover-arrow">↗</span>
        </a>
      </div>

      <div class="flex flex-col gap-2">
        {
          clientesRecientes && clientesRecientes.length > 0 ? (
            clientesRecientes.map((cliente, i) => {
              return <RecentsClientsItem client={cliente} index={i} />;
            })
          ) : (
            <div class="py-12 flex items-center justify-center text-center bg-canvas-white border border-ash-gray rounded-md">
              <p class="font-body text-body-sm font-medium text-steel-gray">
                No hay clientes recientes
              </p>
            </div>
          )
        }
      </div>
    </div>
  </div>
</MainLayout>
