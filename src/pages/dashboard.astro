---
import MainLayout from "../layouts/MainLayout.astro";
import { createClient } from "../lib/supabase.ts";

const supabase = createClient({
  request: Astro.request,
  cookies: Astro.cookies,
});

const {
  data: { user },
} = await supabase.auth.getUser();

if (!user) {
  return Astro.redirect("/");
}

const { data: profile } = await supabase
  .from("profiles")
  .select("*")
  .eq("id", user.id)
  .single();

const firtstName = profile?.full_name.split(" ")[0] || "Freelancer";

const now = new Date();

const formattedDate = now.toLocaleDateString("es-AR", {
  weekday: "long",
  day: "numeric",
  month: "long",
  year: "numeric",
});

const hour = now.getHours();

const greeting =
  hour < 12 ? "Buenos días" : hour < 19 ? "Buenas tardes" : "Buenas noches";

const { count: clientesActivos } = await supabase
  .from("clients")
  .select("id", { count: "exact", head: true })
  .eq("user_id", user.id)
  .eq("status", "activo");

const startOfWeek = new Date(now);
startOfWeek.setDate(now.getDate() - now.getDay() + 1);
startOfWeek.setHours(0, 0, 0, 0);
const endOfWeek = new Date(startOfWeek);
endOfWeek.setDate(startOfWeek.getDate() + 6);
endOfWeek.setHours(23, 59, 59, 999);

const { count: eventosSemana } = await supabase
  .from("events")
  .select("id", { count: "exact", head: true })
  .eq("user_id", user.id)
  .gte("start_at", startOfWeek.toISOString())
  .lte("start_at", endOfWeek.toISOString())
  .neq("status", "cancelado");

const { count: cobrosPendientes } = await supabase
  .from("clients")
  .select("id", { count: "exact", head: true })
  .eq("user_id", user.id)
  .eq("payment_status", "pendiente");

const endWindow = new Date(now);
endWindow.setHours(now.getHours() + 72);

const { data: proximosEventos } = await supabase
  .from("events")
  .select("id, title, type, start_at, clients ( name )")
  .eq("user_id", user.id)
  .gte("start_at", now.toISOString())
  .lte("start_at", endWindow.toISOString())
  .neq("status", "cancelado")
  .order("start_at", { ascending: true })
  .limit(5);

const { data: clientesRecientes } = await supabase
  .from("clients")
  .select("id, name, company, status")
  .eq("user_id", user.id)
  .order("created_at", { ascending: false })
  .limit(5);

const coloresAvatar = [
  "bg-cadet-blue",
  "bg-bubblegum-pink",
  "bg-vivid-green",
  "bg-sunny-yellow",
  "bg-emerald-green",
];

function inicialesCliente(nombre: string) {
  return nombre
    .split(" ")
    .slice(0, 2)
    .map((p) => p[0]?.toUpperCase() ?? "")
    .join("");
}

const colorPorTipo: Record<string, string> = {
  reunion: "bg-cadet-blue",
  deadline: "bg-hot-pink",
  entrega: "bg-vivid-green",
  pago: "bg-sunny-yellow",
  seguimiento: "bg-composer-blue",
  otro: "bg-steel-gray",
};

function formatFechaEvento(iso: string) {
  const d = new Date(iso);
  return {
    fecha: d.toLocaleDateString("es-AR", { day: "numeric", month: "short" }),
    hora: d.toLocaleTimeString("es-AR", { hour: "2-digit", minute: "2-digit" }),
  };
}

console.log(proximosEventos);
---

<MainLayout>
  <div class="relative mb-6">
    <p class="text-steel-gray text-sm mb-1">{formattedDate}</p>
    <h1
      class="text-6xl font-bold font-display text-midnight-ink leading-none max-w-64"
    >
      {greeting},{firtstName}.
    </h1>

    <div class="absolute top-0 right-0 w-32 h-24 pointer-events-none">
      <div class="absolute top-0 right-8 w-13 h-13 bg-vivid-green rounded-sm">
      </div>
      <div class="absolute top-4 right-0 w-15 h-9 bg-bubblegum-pink rounded-sm">
      </div>
      <div
        class="absolute top-10 right-6 w-10 h-10 bg-emerald-green rounded-full"
      >
      </div>
    </div>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-4 mb-6">
    <div
      class="bg-surface-card rounded-xl p-4 shadow-card flex items-start justify-between"
    >
      <div>
        <p class="text-midnight-ink text-sm mb-2">Clientes activos</p>
        <p
          class="text-5xl font-bold font-display text-midnight-ink leading-none"
        >
          {clientesActivos ?? 0}
        </p>
      </div>
      <div class="w-12 h-12 rounded-full bg-vivid-green shrink-0"></div>
    </div>

    <div
      class="bg-surface-card rounded-xl p-4 shadow-card flex items-start justify-between"
    >
      <div>
        <p class="text-midnight-ink text-sm mb-2">Eventos esta semana</p>
        <p
          class="text-5xl font-bold font-display text-midnight-ink leading-none"
        >
          {eventosSemana ?? 0}
        </p>
      </div>
      <div class="w-12 h-12 rounded-full bg-cadet-blue shrink-0"></div>
    </div>

    <div
      class="bg-surface-card rounded-xl p-4 shadow-card flex items-start justify-between"
    >
      <div>
        <p class="text-midnight-ink text-sm mb-2">Cobros pendientes</p>
        <p
          class="text-5xl font-bold font-display text-midnight-ink leading-none"
        >
          {cobrosPendientes ?? 0}
        </p>
      </div>
      <div class="w-12 h-12 rounded-full bg-sunny-yellow shrink-0"></div>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
    <div class="bg-surface-card rounded-xl p-4 shadow-card">
      <div class="flex items-center justify-between mb-4">
        <h2 class="font-bold text-2xl font-display text-midnight-ink">
          Próximos eventos
        </h2>
        <a href="/calendar" class="text-sm text-steel-gray no-underline"
          >Ver todo ↗</a
        >
      </div>

      {
        proximosEventos && proximosEventos.length > 0 ? (
          proximosEventos.map((evento) => {
            const { fecha, hora } = formatFechaEvento(evento.start_at);
            const colorBarra = colorPorTipo[evento.type] ?? "bg-steel-gray";

            const nombreCliente = Array.isArray(evento.clients)
              ? (evento.clients[0]?.name ?? null)
              : ((evento.clients as { name: string } | null)?.name ?? null);
            return (
              <div class="flex items-center justify-between py-3 border-b border-ash-gray last:border-0">
                <div class="flex items-center gap-3">
                  <div class={`w-1 h-10 rounded-full ${colorBarra} shrink-0`} />
                  <div>
                    <p class="font-semibold text-sm text-midnight-ink mb-0.5">
                      {evento.title}
                    </p>
                    <p class="text-steel-gray text-sm capitalize">
                      {nombreCliente ? `${nombreCliente} · ` : ""}
                      {evento.type}
                    </p>
                  </div>
                </div>
                <div class="text-right shrink-0 ml-4">
                  <p class="text-sm text-midnight-ink mb-0.5">{fecha}</p>
                  <p class="text-sm text-steel-gray">{hora}</p>
                </div>
              </div>
            );
          })
        ) : (
          <div class="py-8 text-center">
            <p class="text-steel-gray text-sm">
              Sin eventos en las próximas 72 hs.
            </p>
            <a
              href="/calendar"
              class="text-sm text-cadet-blue no-underline mt-1 inline-block"
            >
              No hay eventos
            </a>
          </div>
        )
      }
    </div>

    <div class="bg-surface-card rounded-xl p-4 shadow-card">
      <div class="flex items-center justify-between mb-4">
        <h2 class="font-bold text-2xl font-display text-midnight-ink">
          Clientes recientes
        </h2>
        <a href="/clients" class="text-sm text-steel-gray no-underline">Ver ↗</a
        >
      </div>

      {
        clientesRecientes && clientesRecientes.length > 0 ? (
          clientesRecientes.map((cliente, i) => {
            const iniciales = inicialesCliente(cliente.name);
            const colorAvatar = coloresAvatar[i % coloresAvatar.length];
            const esActivo = cliente.status === "activo";
            return (
              <a
                href={`/clients/${cliente.id}`}
                class="flex items-center justify-between py-3 border-b border-ash-gray last:border-0 no-underline group"
              >
                <div class="flex items-center gap-3">
                  <div
                    class={`w-10 h-10 rounded-full ${colorAvatar} flex items-center justify-center shrink-0`}
                  >
                    <span class="text-white font-bold text-sm">
                      {iniciales}
                    </span>
                  </div>
                  <div>
                    <p class="font-semibold text-sm text-midnight-ink mb-0.5 group-hover:underline">
                      {cliente.name}
                    </p>
                    <p class="text-steel-gray text-sm">
                      {cliente.company ?? "Sin empresa"}
                    </p>
                  </div>
                </div>
                <span
                  class={`text-xs px-3 py-1 rounded-full font-medium shrink-0 ml-4 ${
                    esActivo
                      ? "bg-vivid-green/10 text-emerald-green"
                      : "bg-ash-gray/30 text-steel-gray"
                  }`}
                >
                  {esActivo ? "Activo" : "Inactivo"}
                </span>
              </a>
            );
          })
        ) : (
          <p class="text-steel-gray text-sm">No hay clientes recientes</p>
        )
      }
      <div class="flex items-center justify-end mt-4">
        <a href="/clients" class="text-sm text-steel-gray no-underline">
          Ver todo ↗
        </a>
      </div>
    </div>
  </div>
</MainLayout>
